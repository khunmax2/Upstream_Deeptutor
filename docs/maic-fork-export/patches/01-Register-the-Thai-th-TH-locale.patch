From c1ce1f7e56e2d1a96f894abee05a8d654ccdfb16 Mon Sep 17 00:00:00 2001
From: khunmax2 <khuncharoenmax1@hotmail.com>
Date: Mon, 7 Sep 2026 02:23:34 +0700
Subject: [PATCH] Register the Thai (th-TH) locale
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Appends th-TH to supportedLocales — the array that drives the language picker —
and wires it into the video-export cover resources so an exported MP4 carries
the Thai CTA strings instead of falling back to another language.

Appended at the END of supportedLocales, never inserted mid-array: the first
locale for a language prefix is used as the default when a browser sends a bare
code, so reordering would change behaviour for existing languages. That rule is
OpenMAIC's own (lib/i18n/TRANSLATION_GUIDE.md).

The locale file itself (lib/i18n/locales/th-TH.json) is generated by
deploy/openmaic-patches/build_th_locale.py and copied in separately: adding a
new file needs no patch and can never conflict on rebase.
---
 integration/maic/lib/i18n/locales.ts                  | 1 +
 integration/maic/lib/video-export-app/cover-config.ts | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/integration/maic/lib/i18n/locales.ts b/integration/maic/lib/i18n/locales.ts
index cafdbf9d1..05ecb2ece 100644
--- a/integration/maic/lib/i18n/locales.ts
+++ b/integration/maic/lib/i18n/locales.ts
@@ -26,4 +26,5 @@ export const supportedLocales = [
   { code: 'fr-FR', label: 'Français', shortLabel: 'FR' },
   { code: 'vi-VN', label: 'Tiếng Việt', shortLabel: 'VI' },
   { code: 'de-DE', label: 'Deutsch', shortLabel: 'DE' },
+  { code: 'th-TH', label: 'ไทย', shortLabel: 'TH' },
 ] as const satisfies readonly LocaleEntry[];
diff --git a/integration/maic/lib/video-export-app/cover-config.ts b/integration/maic/lib/video-export-app/cover-config.ts
index 279fcaf5e..c1af2fd93 100644
--- a/integration/maic/lib/video-export-app/cover-config.ts
+++ b/integration/maic/lib/video-export-app/cover-config.ts
@@ -8,6 +8,7 @@ import jaJP from '@/lib/i18n/locales/ja-JP.json';
 import koKR from '@/lib/i18n/locales/ko-KR.json';
 import ptBR from '@/lib/i18n/locales/pt-BR.json';
 import ruRU from '@/lib/i18n/locales/ru-RU.json';
+import thTH from '@/lib/i18n/locales/th-TH.json';
 import viVN from '@/lib/i18n/locales/vi-VN.json';
 import zhCN from '@/lib/i18n/locales/zh-CN.json';
 import zhTW from '@/lib/i18n/locales/zh-TW.json';
@@ -57,6 +58,7 @@ const LOCALE_RESOURCES: Record<Locale, Record<string, unknown>> = {
   'ru-RU': ruRU,
   'ar-SA': arSA,
   'de-DE': deDE,
+  'th-TH': thTH,
 };
 
 /**
