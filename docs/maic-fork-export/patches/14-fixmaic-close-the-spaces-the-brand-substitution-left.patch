--- a/integration/maic/lib/i18n/locales/th-TH.json
+++ b/integration/maic/lib/i18n/locales/th-TH.json
@@ -530,7 +530,7 @@
       "panRight": "เลื่อนไปทางขวา",
       "collapseAxis": "ย่อเหลือแกนเวลา",
       "expandTrack": "ขยายแทร็ก",
-      "emptyHint": "ลากการกระทำมาวางบนแกนเวลาเพื่อเริ่ม หรือให้ เอเจนต์ AI สร้างคำบรรยายให้",
+      "emptyHint": "ลากการกระทำมาวางบนแกนเวลาเพื่อเริ่ม หรือให้เอเจนต์ AI สร้างคำบรรยายให้",
       "speechPlaceholder": "ใส่คำบรรยายบรรทัดนี้…",
       "reorder": "ลากเพื่อจัดลำดับ",
       "moveLeft": "เลื่อนไปทางซ้าย",
