index 4ef282d89..e4d446a87 100644
--- a/integration/maic/lib/i18n/locales/zh-CN.json
+++ b/integration/maic/lib/i18n/locales/zh-CN.json
@@ -530,7 +530,7 @@
       "panRight": "右移视口",
       "collapseAxis": "收起为轴线",
       "expandTrack": "展开轨道",
-      "emptyHint": "把上方的动作拖到轴上开始编排，或让 AI 智能体 生成讲解。",
+      "emptyHint": "把上方的动作拖到轴上开始编排，或让 AI 智能体生成讲解。",
       "speechPlaceholder": "输入这一句讲解…",
