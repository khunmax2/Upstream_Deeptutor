From 273cbb4fd070f5275fa455fa54ea83cf5fae6630 Mon Sep 17 00:00:00 2001
From: khunmax2 <khuncharoenmax1@hotmail.com>
Date: Mon, 7 Sep 2026 15:43:24 +0700
Subject: [PATCH] fix(maic): close the spaces the brand substitution left in
 ja/th/zh
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Swapping a Latin product name for a native-script phrase left the space that
had separated the Latin run from the text around it. Thai, Japanese and
Chinese do not space words, so 'ให้ เอเจนต์', 'エージェント に' and '智能体 生成'
each read as a break the source does not have.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
---
 integration/maic/lib/i18n/locales/ja-JP.json | 2 +-
 integration/maic/lib/i18n/locales/th-TH.json | 2 +-
 integration/maic/lib/i18n/locales/zh-CN.json | 2 +-
 integration/maic/lib/i18n/locales/zh-TW.json | 2 +-
 4 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/integration/maic/lib/i18n/locales/ja-JP.json b/integration/maic/lib/i18n/locales/ja-JP.json
index 72d23d94d..a8ed92ece 100644
--- a/integration/maic/lib/i18n/locales/ja-JP.json
+++ b/integration/maic/lib/i18n/locales/ja-JP.json
@@ -530,7 +530,7 @@
       "panRight": "右にスクロール",
       "collapseAxis": "軸に折りたたむ",
       "expandTrack": "トラックを展開",
-      "emptyHint": "上のアクションを軸にドラッグして開始するか、AI エージェント にナレーションを生成させましょう。",
+      "emptyHint": "上のアクションを軸にドラッグして開始するか、AI エージェントにナレーションを生成させましょう。",
       "speechPlaceholder": "このナレーションを入力…",
       "reorder": "ドラッグして並べ替え",
       "moveLeft": "左へ移動",
