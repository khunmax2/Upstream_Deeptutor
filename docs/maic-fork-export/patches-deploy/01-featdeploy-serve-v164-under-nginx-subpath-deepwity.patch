--- /dev/null
+++ b/deploy/nginx-deepwitya2.locations.conf
@@ -0,0 +1,66 @@
+# ============================================
+# DeepTutor v2 — nginx location blocks (subpath /deepwitya2)
+# ============================================
+# This host already terminates TLS: there is a Let's Encrypt certificate issued
+# for the IP ITSELF (SAN = IP Address:203.185.144.41, short-lived ~7 day profile,
+# auto-renewed by the snap.certbot.renew.timer). No domain name is involved.
+#
+#   cert:  /etc/letsencrypt/live/203.185.144.41/fullchain.pem
+#   443:   /etc/nginx/sites-available/sansarnnews-ssl  (server_name 203.185.144.41)
+#   80:    /etc/nginx/sites-available/ade              (server_name _)
+#
+# ⚠️ WITHOUT block A below, requests to /deepwitya2 fall through to the existing
+# `location /deepwitya` (nginx prefix matching) and are proxied to the **v1
+# container**, which answers 404 because its Next.js does not know that route.
+# Verified 2026-09-04: the 404 carries `x-powered-by: Next.js`, i.e. it comes
+# from v1's app, not from nginx. So v2 is not merely unreachable — the path is
+# already bound to the wrong upstream.
+# Longest-prefix wins, so once /deepwitya2 exists it correctly beats /deepwitya.
+#
+# Both blocks only ADD a new unique path prefix. No existing location is touched,
+# so /sansarnnews, /research-helper, /dol, /deepwitya, /opdc-assistant and the
+# catch-all are all unaffected.
+#
+# Apply (needs sudo):
+#   sudo nginx -t && sudo systemctl reload nginx
+# ============================================
+
+
+# ---------- BLOCK A ----------
+# PASTE INSIDE the `listen 443 ssl` server block in
+# /etc/nginx/sites-available/sansarnnews-ssl — next to the existing
+# `location /deepwitya`, ABOVE any catch-all.
+#
+# NO trailing slash on proxy_pass: Next.js basePath=/deepwitya2 needs the prefix
+# kept, or /deepwitya2/_next/... resolves to nothing.
+
+location /deepwitya2 {
+    proxy_pass http://127.0.0.1:10320;
+    proxy_http_version 1.1;
+    proxy_set_header Upgrade $http_upgrade;
+    proxy_set_header Connection "upgrade";
+    proxy_set_header Host $host;
+    proxy_set_header X-Real-IP $remote_addr;
+    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+    proxy_set_header X-Forwarded-Proto $scheme;
+    proxy_buffering off;
+    proxy_read_timeout 3600s;
+    proxy_send_timeout 3600s;
+}
+
+
+# ---------- BLOCK B ----------
+# PASTE INSIDE the `listen 80` server block in /etc/nginx/sites-available/ade
+# (server_name _), ABOVE the catch-all `location / { ... }`.
+#
+# Forces HTTPS for THIS PATH ONLY. Every other project on :80 keeps its current
+# behaviour — this is a per-location redirect, not a server-wide one, precisely
+# so /dopa, /dol, /research-helper, /fda, /deepwitya and / are left alone.
+#
+# Note: no HSTS header here. HSTS is per-HOST, not per-path, so setting it would
+# force EVERY path on this IP to HTTPS in visitors' browsers — including projects
+# that may still need plain HTTP. Leave HSTS to whoever owns the host policy.
+
+location /deepwitya2 {
+    return 301 https://$host$request_uri;
+}
