# dependencies
# Docker matches .dockerignore patterns from the context root, not at every
# level like .gitignore, so the nested workspace copies need explicit globs.
# On a Windows host pnpm writes them as absolute D:/... symlinks, which are
# dead inside the container and shadow the ones the deps stage built.
node_modules
**/node_modules
.pnpm-store

# build output
# Package dist/ is rebuilt by the deps stage postinstall; copying the host copy
# only risks staleness.
.next
out
build
dist
**/dist

# git
.git
.gitignore

# IDE
.idea
.vscode

# env & secrets
.env*
!.env.example
server-providers*.yml

# misc
assets
*.md
*.pdf
*.pem
.DS_Store
.vercel
coverage
logs
data
docs
.claude

# isolated MP4 render service — built as its own image (render-service/Dockerfile),
# never part of the main app image.
render-service
