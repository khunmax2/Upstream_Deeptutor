# Course Studio model providers -- copy to deploy/openmaic.env (gitignored).
# Read by the studio container only (deploy/docker-compose.openmaic.yml
# env_file). Env beats the studio's YAML config; a pinned *_MODELS list beats a
# client choice it does not contain, and its first entry is the default.
# Names come from lib/server/provider-config.ts in khunmax2/Ups_openMAIC.

# --- Chat / agent LLM (any OpenAI-compatible endpoint) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODELS=

# --- Image generation: a self-hosted OpenAI-compatible server ---
# The fork's "OpenAI Compatible" provider (id custom-image): same
# /images/generations protocol, no preloaded catalogue, key optional. Set the
# server's base URL and the model names it serves; the first is the default.
#
# This is the one that matters for course generation: the studio's job runner
# (agent runtime) reads ONLY server-configured providers, never the browser
# Settings page, so an image provider entered there alone is invisible to it.
IMAGE_CUSTOM_BASE_URL=
IMAGE_CUSTOM_API_KEY=
IMAGE_CUSTOM_MODELS=
# DEFAULT_IMAGE_PROVIDER=custom-image

# --- Image generation: OpenAI itself ---
IMAGE_OPENAI_API_KEY=
IMAGE_OPENAI_MODELS=
# IMAGE_OPENAI_ENABLED=false

# --- Speech, OpenAI-compatible (/audio/speech) ---
# *_VOICES is a fork addition: the voice list the endpoint accepts. Without it
# the client's voice name is sent through unchanged. Endpoints that answer raw
# PCM (audio/L16) are decoded into WAV by the fork; set TTS_L16_BYTE_ORDER=be
# only if the endpoint follows RFC 2586 rather than the common little-endian.
TTS_OPENAI_API_KEY=
TTS_OPENAI_BASE_URL=
TTS_OPENAI_MODELS=
TTS_OPENAI_VOICES=
# TTS_L16_BYTE_ORDER=le
