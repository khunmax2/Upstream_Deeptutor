# Copy to deploy/production.env on the host (gitignored) and fill in.
# Passed to docker compose as a second --env-file next to docker.env.

# The studio image, BY DIGEST, from deploy/openmaic-patches/openmaic-pin.json
# (image.ref + "@" + image.digest). A tag would let two hosts run different
# code while both look correctly configured; the compose overlay refuses an
# empty value and this file refuses a floating one by convention.
OPENMAIC_IMAGE=ghcr.io/khunmax2/deepwitya-studio@sha256:REPLACE_WITH_THE_PINNED_DIGEST

# The studio database's password. Generated once, never changed casually: the
# postgres image only reads it when the volume is first created.
#   openssl rand -hex 24
OPENMAIC_POSTGRES_PASSWORD=REPLACE_ME
